# Q-MedSense Frontend Client (Vite) Environment Configuration Template
VITE_APP_TITLE=Q-MedSense — Quantum Clinical Decision Support OS
VITE_APP_VERSION=2.0.0
VITE_ENVIRONMENT=production

# Backend REST API Gateway Base URL
# In local dev: http://localhost:8000/api/v1 (or /api/v1 when using Vite dev proxy)
# In production (cross-origin): https://api.qmedsense.health/api/v1
# In production (same-origin): /api/v1
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_ORIGIN=http://localhost:8000

# API Gateway Key (Passed via X-API-Key header)
VITE_API_KEY=qmed-master-api-key-2026

# Emergency Portal Base URL for QR Codes
VITE_EMERGENCY_PORTAL_BASE=https://qmedsense.health/#emergency

# Feature Toggles
VITE_ENABLE_3D_DIGITAL_TWIN=true
VITE_ENABLE_QUANTUM_TELEMETRY=true
VITE_ENABLE_RESEARCHER_STUDIO=true
VITE_ENABLE_MOCK_FALLBACK=false

# Request Timeout
VITE_API_TIMEOUT_MS=15000

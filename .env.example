# ==============================================================================
# Q-MedSense: Master Environment Template (.env.example)
# ==============================================================================

# Backend Server Configuration
QMED_DB_MODE=demo
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# Frontend Client Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1

# JWT Security & Encryption
SECRET_KEY=your-secure-random-256-bit-secret-key-here
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# Pre-Configured Role Authority Credentials
ADMIN_USERNAME=admin.audit
ADMIN_PASSWORD=admin123

CLINICIAN_USERNAME=dr.aryan
CLINICIAN_PASSWORD=clinician123

RESEARCHER_USERNAME=priya.qml
RESEARCHER_PASSWORD=quantum123

PATIENT_USERNAME=alex.patient
PATIENT_PASSWORD=patient123

# Quantum Engine Simulator Configuration
QUANTUM_BACKEND=default.qubit
DEFAULT_QUBITS=8
DEFAULT_LAYERS=2
QUANTUM_SHOTS=1000

# SQLite Database
DATABASE_PATH=qmedsense.db

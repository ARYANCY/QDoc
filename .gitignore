# ==============================================================================
# Q-MedSense Git Ignore Configuration
# ==============================================================================

# Python Environments & Caches
.venv/
venv/
ENV/
env/
.env.local
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Databases & Runtime State
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/qmedsense.db
backend/qmedsense_demo.db
qmedsense.db
qmedsense_demo.db

# Frontend Dependencies & Build Outputs
node_modules/
dist/
frontend/dist/
frontend/node_modules/
card-frontend/dist/
card-frontend/node_modules/
.eslintcache

# Environment Variables & Secrets
.env
*.env
!*.env.example
*.secret
*.pem
*.key

# Machine Learning Binary Weights (>100MB files that break git push)
*.pt
*.pth
*.pkl
*.onnx
*.npy
*.npz
*.h5

# Whitelist ML Model Architecture & Metadata JSONs
!models/**/config.json
!models/**/metrics.json
!models/**/labels.json
!models/**/calibration.json
!models/**/training_history.json
!models/**/pca_meta.json
!models/**/experiment.json
!models/**/final_metrics.json
!models/registry.json
!models/**/*.gitkeep

# Reports, Generated Visualizations & Large Datasets
reports/skin_cancer/cache/
reports/generated_graphs/
backend/graphs/generated/
datasets/
logs/
*.log
!reports/README.md

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
scratch/
*.swp
*.swo

# Whitelist Essential Configuration & Entry Files
!main.py
!requirements.txt
!backend/requirements.txt
!pyproject.toml
!pytest.ini
!README.md
!.dockerignore
!docker-compose.yml

# ==============================================================================
# Q-MedSense Root .gitignore (Production Multi-Tier Repository)
# ==============================================================================

# OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Environment Variables (Keep only .env.example tracked)
.env
.env*.local
.env.production
.env.staging
frontend/.env
frontend/.env.production
backend/.env
backend/.env.production
model/.env
model/.env.production
!.env.example
!frontend/.env.example
!backend/.env.example
!model/.env.example

# Build Outputs & Dependencies
node_modules/
dist/
build/
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/

# Databases & Runtime State
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/qmedsense.db
backend/qmedsense_demo.db
qmedsense.db
qmedsense_demo.db

# Storage, Uploads & Reports
storage/uploads/*
!storage/uploads/.gitkeep
storage/reports/*
!storage/reports/.gitkeep
reports/*.pdf
reports/*.json

# Heavy Datasets & Model Weights (Managed via Cloud Storage / S3 / HuggingFace)
datasets/
data/raw/
data/processed/
*.zip
*.tar.gz
*.tar
*.7z
*.vcf
*.dcm
*.npy
reports/skin_cancer/cache/

# Test Caches & Logs
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log

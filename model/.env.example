# ==============================================================================
# Q-RAKSHAK Model Inference Microservice Configuration Template
# ==============================================================================

MODEL_SERVICE_HOST=0.0.0.0
MODEL_SERVICE_PORT=8001
ENVIRONMENT=production
LOG_LEVEL=INFO

# Compute Device ('cuda', 'cuda:0', 'mps', or 'cpu')
DEVICE=cpu
TORCH_NUM_THREADS=4

# Quantum Simulation Engine
QUANTUM_BACKEND=default.qubit
QUANTUM_SHOTS=1024
DEFAULT_QUBITS=8
DEFAULT_LAYERS=2

# Weights & Storage Directories
WEIGHTS_DIR=weights
MODEL_CACHE_DIR=/tmp/model_cache

# Hugging Face Hub (Optional, required for gated foundation models like MedGemma)
HUGGINGFACE_HUB_TOKEN=
HF_TOKEN=

# Internal Service Security
MODEL_SERVICE_API_KEY=qmed-internal-model-key-secure-prod-2026
BACKEND_WEBHOOK_URL=http://backend:8000/api/v1/researcher/training-callback

# Inference Optimization
MAX_BATCH_SIZE=16
INFERENCE_TIMEOUT_SECONDS=30

// ==============================================================================
// Q-MedSense: Master Prisma Schema Specification (schema.prisma)
// Compatible with PostgreSQL, SQLite, or Prisma Cloud Data Platform
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. User & Authentication Authority
// ------------------------------------------------------------------------------
model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  passwordHash         String    @map("password_hash")
  name                 String
  email                String
  secondaryEmail       String?   @map("secondary_email")
  emergencyPhone       String?   @map("emergency_phone")
  role                 String    // 'patient' | 'doctor' | 'clinician' | 'researcher' | 'admin'
  hospitalAffiliation  String?   @map("hospital_affiliation")
  licenseNumber        String?   @map("license_number")
  createdAt            DateTime  @default(now()) @map("created_at")

  doctors              Doctor[]
  notifications        Notification[]

  @@map("users")
}

// ------------------------------------------------------------------------------
// 2. Patient Clinical Profiles & Baselines
// ------------------------------------------------------------------------------
model Patient {
  id                   String    @id @default(uuid())
  mrn                  String    @unique // Medical Record Number
  name                 String
  age                  Int
  gender               String
  bloodGroup           String    @map("blood_group")
  heightCm             Float?    @default(175.0) @map("height_cm")
  weightKg             Float?    @default(70.0) @map("weight_kg")
  conditionsJson       String    @default("[]") @map("conditions_json")
  baselineVitalsJson   String    @default("{}") @map("baseline_vitals_json")
  emergencyContact     String?   @map("emergency_contact")
  medicalHistoryJson   String?   @map("medical_history_json")
  allergiesJson        String?   @map("allergies_json")
  medicationsJson      String?   @map("medications_json")
  emergencyContactsJson String?  @map("emergency_contacts_json")
  createdAt            DateTime  @default(now()) @map("created_at")

  diagnosticRecords    DiagnosticRecord[]
  earlyDetection       EarlyDetectionAssessment[]
  bookings             Booking[]
  prescriptions        Prescription[]
  consent              Consent?

  @@map("patients")
}

// ------------------------------------------------------------------------------
// 3. AI & Quantum Diagnostic Records
// ------------------------------------------------------------------------------
model DiagnosticRecord {
  id                   String    @id @default(uuid())
  patientId            String    @map("patient_id")
  disease              String
  modelArchitecture    String    @map("model_architecture")
  predictionClass      String    @map("prediction_class")
  confidence           Float
  classicalModel       String    @map("classical_model")
  classicalConfidence  Float     @map("classical_confidence")
  probabilitiesJson    String    @map("probabilities_json")
  explainabilityJson   String    @map("explainability_json")
  inferenceMs          Float     @map("inference_ms")
  fallbackUsed         Int       @default(0) @map("fallback_used")
  createdAt            DateTime  @default(now()) @map("created_at")

  patient              Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@map("diagnostic_records")
}

// ------------------------------------------------------------------------------
// 4. Skin Cancer Prediction Records
// ------------------------------------------------------------------------------
model SkinCancerPrediction {
  id                String    @id @default(uuid())
  filename          String
  model             String
  predictionClass   String    @map("prediction_class")
  confidence        Float
  probabilitiesJson String    @map("probabilities_json")
  quantumInfoJson   String?   @map("quantum_info_json")
  inferenceMs       Float?    @map("inference_ms")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("skin_cancer_predictions")
}

// ------------------------------------------------------------------------------
// 5. Immutable WORM Audit Logs (HIPAA / DPDP)
// ------------------------------------------------------------------------------
model AuditLog {
  id             String    @id @default(uuid())
  timestamp      String
  actor          String
  action         String
  resource       String
  ipAddress      String    @map("ip_address")
  status         String
  hashSignature  String    @map("hash_signature")

  @@index([actor])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 6. Patient Consent Management (DPDP Act 2023)
// ------------------------------------------------------------------------------
model Consent {
  patientId        String    @id @map("patient_id")
  dpdpOptIn        Int       @default(1) @map("dpdp_opt_in")
  telemetrySharing Int       @default(1) @map("telemetry_sharing")
  researchAccess   Int       @default(1) @map("research_access")
  updatedAt        DateTime  @default(now()) @map("updated_at")

  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("consents")
}

// ------------------------------------------------------------------------------
// 7. Early Detection Multi-Year Risk Trajectories
// ------------------------------------------------------------------------------
model EarlyDetectionAssessment {
  id               String    @id @default(uuid())
  patientId        String    @map("patient_id")
  protocol         String
  riskTier         String    @map("risk_tier") // 'Low' | 'Moderate' | 'High' | 'Critical'
  trajectoryStage  Int       @map("trajectory_stage")
  biomarkersJson   String    @map("biomarkers_json")
  createdAt        DateTime  @default(now()) @map("created_at")

  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("early_detection_assessments")
}

// ------------------------------------------------------------------------------
// 8. Doctors Directory & Tele-Health
// ------------------------------------------------------------------------------
model Doctor {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  name                String
  specialty           String
  registrationNumber  String    @map("registration_number")
  councilName         String    @map("council_name")
  experienceYears     Int       @map("experience_years")
  feeInr              Float     @map("fee_inr")
  rating              Float?    @default(4.8)
  languagesJson       String    @map("languages_json")
  hospitalAffiliation String    @map("hospital_affiliation")
  availableSlotsJson  String    @map("available_slots_json")
  verificationStatus  String?   @default("verified") @map("verification_status")
  createdAt           DateTime  @default(now()) @map("created_at")

  user                User      @relation(fields: [userId], references: [id])
  bookings            Booking[]
  prescriptions       Prescription[]

  @@map("doctors")
}

// ------------------------------------------------------------------------------
// 9. Consultation Bookings & State Machine
// ------------------------------------------------------------------------------
model Booking {
  id                 String              @id @default(uuid())
  patientId          String              @map("patient_id")
  doctorId           String              @map("doctor_id")
  slotTime           String              @map("slot_time")
  mode               String              @default("video")
  status             String              @default("requested") // 'requested' | 'confirmed' | 'in_session' | 'completed' | 'cancelled'
  paymentStatus      String              @default("authorized") @map("payment_status")
  intakeJson         String?             @map("intake_json")
  triageRisk         String?             @default("normal") @map("triage_risk")
  emergencyFlagsJson String?             @map("emergency_flags_json")
  createdAt          DateTime            @default(now()) @map("created_at")

  patient            Patient             @relation(fields: [patientId], references: [id])
  doctor             Doctor              @relation(fields: [doctorId], references: [id])
  room               ConsultationRoom?
  signals            ConsultationSignal[]
  prescriptions      Prescription[]

  @@map("bookings")
}

// ------------------------------------------------------------------------------
// 10. Virtual Consultation Rooms & Signaling
// ------------------------------------------------------------------------------
model ConsultationRoom {
  id                 String    @id @default(uuid())
  bookingId          String    @unique @map("booking_id")
  roomToken          String    @map("room_token")
  status             String    @default("waiting") // 'waiting' | 'active' | 'closed'
  doctorJoined       Int       @default(0) @map("doctor_joined")
  patientJoined      Int       @default(0) @map("patient_joined")
  chatMessagesJson   String?   @default("[]") @map("chat_messages_json")
  createdAt          DateTime  @default(now()) @map("created_at")

  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("consultation_rooms")
}

model ConsultationSignal {
  id           Int       @id @default(autoincrement())
  bookingId    String    @map("booking_id")
  senderId     String    @map("sender_id")
  senderRole   String    @map("sender_role")
  signalType   String    @map("signal_type")
  payloadJson  String    @map("payload_json")
  createdAt    DateTime  @default(now()) @map("created_at")

  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("consultation_signals")
}

// ------------------------------------------------------------------------------
// 11. E-Prescriptions & Digital Signatures
// ------------------------------------------------------------------------------
model Prescription {
  id                   String    @id @default(uuid())
  bookingId            String    @map("booking_id")
  patientId            String    @map("patient_id")
  doctorId             String    @map("doctor_id")
  diagnosis            String
  medicationsJson      String    @map("medications_json")
  carePlanJson         String    @map("care_plan_json")
  soapNotesJson        String    @map("soap_notes_json")
  digitalSignatureHash String    @map("digital_signature_hash")
  createdAt            DateTime  @default(now()) @map("created_at")

  booking              Booking   @relation(fields: [bookingId], references: [id])
  patient              Patient   @relation(fields: [patientId], references: [id])
  doctor               Doctor    @relation(fields: [doctorId], references: [id])

  @@map("prescriptions")
}

// ------------------------------------------------------------------------------
// 12. In-App Notifications
// ------------------------------------------------------------------------------
model Notification {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  title         String
  message       String
  referenceCode String?   @map("reference_code")
  category      String
  isRead        Int       @default(0) @map("is_read")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
